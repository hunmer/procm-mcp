{
  "name": "@hunmer/procm-mcp-sdk",
  "version": "0.1.0",
  "description": "TypeScript client and structured logger for procm-mcp rooms",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "link:local": "node ../../scripts/link-sdk.mjs",
    "publish:public": "node ../../scripts/publish-sdk.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "callsites": "4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
